### Редактирование сообщения
### Если пользователь удалил сообщение - можем получить HTTP/1.1 400 Bad Request "description": "Bad Request: message to edit not found"
POST https://api.telegram.org/bot{{bot_token}}/
Content-Type: application/json

{
    "method": "editmessagetext",
    "message_id": 661,
    "chat_id": 47254369,
    "protect_content": true,
    "text": "Укажите страну гражданства:",
    "reply_markup": {
        "inline_keyboard": [
            [
                {"text": "🇷🇺 Россия", "callback_data": "value|ru"},
                {"text": "🇧🇾 Беларусь", "callback_data": "value|by"}
            ],
            [
                {"text": "🇦🇲 Армения", "callback_data": "value|am"},
                {"text": "🇺🇿 Узбекистан", "callback_data": "value|uz"}
            ],

            [
                {"text": "⏮️ Назад", "callback_data": "back"},
                {"text": "🏠 В начало", "callback_data": "main_form"}
            ]
        ]
    }
}

### Удаление сообщений
### "message_ids": [643,644,645,646,647,648,649,650,651,653,653,654,655,656]
POST https://api.telegram.org/bot{{bot_token}}/
Content-Type: application/json

{
    "method": "deletemessages",
    "chat_id": 47254369,
    "message_ids": [642,641,640,639,638,637,636,635,634,633,632,631,630,629]
}