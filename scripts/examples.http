}


### Ввод номера телефона
POST https://api.telegram.org/bot{{bot_token}}/
Content-Type: application/json

{
    "method": "sendmessage",
    "chat_id": 47254369,
    "protect_content": true,
    "text": "Предоставьте свой номер телефона:",
    "reply_markup": {
      "one_time_keyboard": true,
      "keyboard": [
        [{
          "text": "Отправить номер", "request_contact": true
        }],
        ["Cancel"]]
    }
}

### Ввод текстового параметра с вариантом выбора по кнопке
POST https://api.telegram.org/bot{{bot_token}}/
Content-Type: application/json

{
    "method": "sendmessage",
    "chat_id": 47254369,
    "protect_content": true,
    "text": "Введите Ваше отчество:",
    "reply_markup": {
        "inline_keyboard": [
            [
                {"text": "Отсутствует", "callback_data": "value|-"}
            ],
            [
                {"text": "⏮️ Назад", "callback_data": "back"},
                {"text": "🏠 В начало", "callback_data": "main_form"}
            ]
        ]
    }
}

