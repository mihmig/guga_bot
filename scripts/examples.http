### Удалить сообщение
POST https://api.telegram.org/bot{{bot_token}}/deletemessage?chat_id=47254369&message_id=22

### Простое сообщение
POST https://api.telegram.org/bot{{bot_token}}/
Content-Type: application/json

{
  "method": "sendmessage",
  "chat_id": "47254369",
  "message_id": 675,
  "text": "Привет!"
}

### Редактирование сообщения
POST https://api.telegram.org/bot{{bot_token}}/
Content-Type: application/json

{
  "method": "editmessagetext",
  "message_id": 661,
  "chat_id": "47254369",
  "text": "Привет!"
}

### Клавиатура снизу
POST https://api.telegram.org/bot{{bot_token}}/
Content-Type: application/json

{
  "method": "sendmessage",
  "chat_id": "47254369",
  "text": "Укажите Ваш пол",
         "reply_markup": {
             "one_time_keyboard": true,
             "keyboard": [
                [{"text": "Мужской"}, {"text": "Женский"}
                ],
               ["Отмена"]]
         }
     }

### Клавиатура обычная
POST https://api.telegram.org/bot{{bot_token}}/
Content-Type: application/json

{
    "method": "sendmessage",
    "chat_id": 47254369,
    "text": "Выберите пункт анкеты",
    "reply_markup": {
        "inline_keyboard": [
            [
                {"text": "Фамилия", "callback_data": "last_name"},
                {"text": "Имя", "callback_data": "first_name"},
                {"text": "Отчество", "callback_data": "middle_name"}
            ],
            [
                {"text": "📱 Контактный телефон", "callback_data": "phone"},
                {"text": "📅 Дата рождения", "callback_data": "birthdate"}
            ],
            [
                {"text": "Пол 👨/👩", "callback_data": "sex"},
                {"text": "📧 e-mail", "callback_data": "email"}
            ],
            [
                {"text": "ИНН", "callback_data": "inn"},
                {"text": "Рост", "callback_data": "size"}
            ],
            [
                {"text": "⏮️ Назад", "callback_data": "main_menu"},
                {"text": "🏠 В начало", "callback_data": "main_menu"},
                {"text": "Далее ⏭️", "callback_data": "profile_menu_2"}
            ]
        ]
    }
}

